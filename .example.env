ONPATIENT_CLIENT_SECRET=
ONPATIENT_CLIENT_ID=
PUBLIC_URL=https://localhost:4200
PORT=4201
EPIC_CLIENT_ID=
EPIC_CLIENT_ID_DSTU2=
EPIC_CLIENT_ID_R4=
EPIC_SANDBOX_CLIENT_ID=
EPIC_SANDBOX_CLIENT_ID_DSTU2=
EPIC_SANDBOX_CLIENT_ID_R4=
CERNER_CLIENT_ID=
VA_CLIENT_ID=
VERADIGM_CLIENT_ID=
HEALOW_CLIENT_ID=
HEALOW_CLIENT_SECRET=
ATHENA_CLIENT_ID=
ATHENA_SANDBOX_CLIENT_ID=
NEXTGEN_CLIENT_ID=
NEXTGEN_CLIENT_SECRET=
# A Healow, NextGen, or OnPatient client secret needs APP_KEY or ALLOW_PUBLIC_CONFIDENTIAL_CLIENTS=true. See https://meremedical.co/docs/getting-started/docker#app-key
# APP_KEY signs the registration token in invite links. Generate it with generate-app-key.
APP_KEY=
# Optional, used with APP_KEY. Who users ask for an invite link, such as an email address.
APP_CONTACT=
# Set to true to turn off the registration token check, so APP_KEY and APP_CONTACT are not needed. Ignored when APP_KEY is set.
ALLOW_PUBLIC_CONFIDENTIAL_CLIENTS=
