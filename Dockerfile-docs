FROM node:26.10-bookworm@sha256:2aaae6d91f99fee84cfc92da9b52c22a185752d247746052bbc3f961e44478c6 AS build-stage

WORKDIR /app
COPY package*.json /app/
RUN npm ci

COPY . /app/
ENV NX_DAEMON=false
RUN npx nx build docs

FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:26b0bf6fbf07297983cb341998d79c831508787de26627dd2a112321b9c3a4af

COPY --from=build-stage /app/apps/docs/build /usr/share/nginx/html
COPY --from=build-stage /app/default.conf /etc/nginx/conf.d/default.conf
