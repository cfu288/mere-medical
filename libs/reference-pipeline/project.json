{
  "name": "reference-pipeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/reference-pipeline/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/reference-pipeline"],
      "options": {
        "jestConfig": "libs/reference-pipeline/jest.config.ts"
      }
    },
    "build-library": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register/transpile-only libs/reference-pipeline/src/cli.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TS_NODE_PROJECT": "libs/reference-pipeline/tsconfig.spec.json"
        }
      }
    }
  }
}
